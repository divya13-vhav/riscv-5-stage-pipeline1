module control_unit (
    input  [6:0] opcode,
    input  [2:0] funct3,
    input  [6:0] funct7,

    output reg       RegWrite,
    output reg       MemRead,
    output reg       MemWrite,
    output reg       MemToReg,
    output reg       ALUSrc,
    output reg       Branch,
    output reg       BranchNE,

    output reg [3:0] ALUControl
);

    always @(*) begin

        // -------------------------------------------------
        // Default values
        // -------------------------------------------------

        RegWrite   = 1'b0;
        MemRead    = 1'b0;
        MemWrite   = 1'b0;
        MemToReg   = 1'b0;
        ALUSrc     = 1'b0;
        Branch     = 1'b0;
        BranchNE   = 1'b0;

        // Default ALU operation = ADD
        ALUControl = 4'b0000;


        // -------------------------------------------------
        // Decode instruction using opcode
        // -------------------------------------------------

        case (opcode)


            // =================================================
            // R-TYPE INSTRUCTIONS
            //
            // ADD
            // SUB
            // AND
            // OR
            // XOR
            // SLT
            // =================================================

            7'b0110011: begin

                // Result will be written into rd
                RegWrite = 1'b1;

                // ALU uses two registers
                ALUSrc = 1'b0;


                case (funct3)

                    // -----------------------------------------
                    // ADD / SUB
                    // -----------------------------------------

                    3'b000: begin

                        if (funct7 == 7'b0100000)
                            ALUControl = 4'b0001;   // SUB

                        else
                            ALUControl = 4'b0000;   // ADD

                    end


                    // -----------------------------------------
                    // AND
                    // -----------------------------------------

                    3'b111:
                        ALUControl = 4'b0010;


                    // -----------------------------------------
                    // OR
                    // -----------------------------------------

                    3'b110:
                        ALUControl = 4'b0011;


                    // -----------------------------------------
                    // XOR
                    // -----------------------------------------

                    3'b100:
                        ALUControl = 4'b0100;


                    // -----------------------------------------
                    // SLT
                    // -----------------------------------------

                    3'b010:
                        ALUControl = 4'b0101;


                    default:
                        ALUControl = 4'b0000;

                endcase

            end


            // =================================================
            // I-TYPE ARITHMETIC
            //
            // ADDI
            // ANDI
            // ORI
            // XORI
            // SLTI
            // =================================================

            7'b0010011: begin

                // Result written to rd
                RegWrite = 1'b1;

                // ALU uses immediate instead of rs2
                ALUSrc = 1'b1;


                case (funct3)

                    // ADDI
                    3'b000:
                        ALUControl = 4'b0000;


                    // ANDI
                    3'b111:
                        ALUControl = 4'b0010;


                    // ORI
                    3'b110:
                        ALUControl = 4'b0011;


                    // XORI
                    3'b100:
                        ALUControl = 4'b0100;


                    // SLTI
                    3'b010:
                        ALUControl = 4'b0101;


                    default:
                        ALUControl = 4'b0000;

                endcase

            end


            // =================================================
            // LOAD WORD
            //
            // LW
            // =================================================

            7'b0000011: begin

                // Write loaded data into register
                RegWrite = 1'b1;

                // Read from data memory
                MemRead = 1'b1;

                // Don't write to memory
                MemWrite = 1'b0;

                // Select memory output for writeback
                MemToReg = 1'b1;

                // ALU uses immediate to calculate address
                ALUSrc = 1'b1;

                // Address = register + immediate
                ALUControl = 4'b0000;

            end


            // =================================================
            // STORE WORD
            //
            // SW
            // =================================================

            7'b0100011: begin

                // SW does not write to register
                RegWrite = 1'b0;

                // Don't read memory
                MemRead = 1'b0;

                // Write to memory
                MemWrite = 1'b1;

                // ALU uses immediate
                ALUSrc = 1'b1;

                // Address = register + immediate
                ALUControl = 4'b0000;

            end


            // =================================================
            // BRANCH
            //
            // BEQ
            // BNE
            // =================================================

            7'b1100011: begin

                // Branch does not write a register
                RegWrite = 1'b0;

                MemRead = 1'b0;
                MemWrite = 1'b0;
                MemToReg = 1'b0;

                // Branch comparison uses two registers
                ALUSrc = 1'b0;

                // Tell CPU this is a branch
                Branch = 1'b1;


                case (funct3)

                    // -----------------------------------------
                    // BEQ
                    // -----------------------------------------

                    3'b000:
                        BranchNE = 1'b0;


                    // -----------------------------------------
                    // BNE
                    // -----------------------------------------

                    3'b001:
                        BranchNE = 1'b1;


                    default:
                        BranchNE = 1'b0;

                endcase


                // SUB is used for comparison
                ALUControl = 4'b0001;

            end


            // =================================================
            // UNKNOWN / UNSUPPORTED INSTRUCTION
            // =================================================

            default: begin

                RegWrite   = 1'b0;
                MemRead    = 1'b0;
                MemWrite   = 1'b0;
                MemToReg   = 1'b0;
                ALUSrc     = 1'b0;
                Branch     = 1'b0;
                BranchNE   = 1'b0;

                ALUControl = 4'b0000;

            end

        endcase

    end

endmodule
