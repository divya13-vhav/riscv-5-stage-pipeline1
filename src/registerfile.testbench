`timescale 1ns/1ps

module register_file_tb;

    reg clk;
    reg reset;
    reg RegWrite;

    reg [4:0] rs1;
    reg [4:0] rs2;
    reg [4:0] rd;

    reg [31:0] WriteData;

    wire [31:0] ReadData1;
    wire [31:0] ReadData2;

    register_file dut (
        .clk(clk),
        .reset(reset),
        .RegWrite(RegWrite),
        .rs1(rs1),
        .rs2(rs2),
        .rd(rd),
        .WriteData(WriteData),
        .ReadData1(ReadData1),
        .ReadData2(ReadData2)
    );

    // Clock
    always #5 clk = ~clk;

    initial begin

        // Waveform generation
        $dumpfile("dump.vcd");
        $dumpvars(0, register_file_tb);

        // Initial values
        clk = 0;
        reset = 1;
        RegWrite = 0;
        rs1 = 0;
        rs2 = 0;
        rd = 0;
        WriteData = 0;

        // Reset
        #10;
        reset = 0;

        // Write 100 to x1
        #5;
        RegWrite = 1;
        rd = 5'd1;
        WriteData = 32'd100;

        #10;

        // Write 200 to x2
        rd = 5'd2;
        WriteData = 32'd200;

        #10;

        // Stop writing
        RegWrite = 0;

        // Read x1 and x2
        rs1 = 5'd1;
        rs2 = 5'd2;

        #10;

        $display("x1 = %d", ReadData1);
        $display("x2 = %d", ReadData2);

        // Read x0
        rs1 = 5'd0;

        #10;

        $display("x0 = %d", ReadData1);

        #10;

        $finish;

    end

endmodule
